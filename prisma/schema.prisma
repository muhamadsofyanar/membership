generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  REJECTED
  EXPIRED
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

model User {
  id                 String       @id @default(cuid())
  name               String
  email              String       @unique
  phone              String?
  sessionVersion     Int          @default(0)
  isActive           Boolean      @default(true)
  resetTokens        PasswordReset[]
  payouts            Payout[]
  passwordHash       String
  role               Role         @default(MEMBER)
  referralCode       String       @unique
  referredById       String?
  referredBy         User?        @relation("Referrals", fields: [referredById], references: [id])
  referrals          User[]       @relation("Referrals")
  orders             Order[]
  memberships        Membership[]
  earnedCommissions  Commission[] @relation("AffiliateCommissions")
  sourceCommissions  Commission[] @relation("SourceCommissions")
  lessonProgress     LessonProgress[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model Plan {
  id                 String       @id @default(cuid())
  name               String
  slug               String       @unique
  description        String
  price               Int
  durationDays        Int
  affiliatePercent   Int          @default(20)
  features            Json
  isPopular           Boolean      @default(false)
  isActive            Boolean      @default(true)
  orders              Order[]
  memberships         Membership[]
  courses             Course[]    @relation("PlanCourses")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model Course {
  id                 String       @id @default(cuid())
  title              String
  slug               String       @unique
  description        String
  thumbnail          String?
  isPublished        Boolean      @default(false)
  plans              Plan[]       @relation("PlanCourses")
  modules            Module[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model Module {
  id                 String       @id @default(cuid())
  courseId           String
  course             Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title              String
  position           Int
  lessons            Lesson[]

  @@unique([courseId, position])
}

model Lesson {
  id                 String       @id @default(cuid())
  moduleId           String
  module             Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title              String
  content            String
  videoUrl           String?
  durationMinutes    Int          @default(5)
  position           Int
  isPreview          Boolean      @default(false)
  progress           LessonProgress[]

  @@unique([moduleId, position])
}

model LessonProgress {
  id                 String       @id @default(cuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId           String
  lesson             Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt        DateTime      @default(now())

  @@unique([userId, lessonId])
}

model Order {
  id                 String       @id @default(cuid())
  invoice            String       @unique
  userId             String
  user               User         @relation(fields: [userId], references: [id])
  planId             String
  plan               Plan         @relation(fields: [planId], references: [id])
  amount             Int
  durationDaysSnapshot Int?
  affiliatePercentSnapshot Int?
  status             OrderStatus  @default(PENDING)
  paymentMethod      String       @default("BANK_TRANSFER")
  paymentProof       String?
  transferAccount    String?
  notes              String?
  paidAt             DateTime?
  reviewedAt         DateTime?
  membership         Membership?
  commission         Commission?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([userId, status])
}

model Membership {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id])
  planId             String
  plan               Plan             @relation(fields: [planId], references: [id])
  orderId            String            @unique
  order              Order             @relation(fields: [orderId], references: [id])
  startsAt           DateTime
  endsAt             DateTime
  status             MembershipStatus @default(ACTIVE)
  createdAt          DateTime         @default(now())
}

model Commission {
  id                 String           @id @default(cuid())
  affiliateId        String
  affiliate          User             @relation("AffiliateCommissions", fields: [affiliateId], references: [id])
  sourceUserId       String
  sourceUser         User             @relation("SourceCommissions", fields: [sourceUserId], references: [id])
  orderId            String           @unique
  order              Order            @relation(fields: [orderId], references: [id])
  amount             Int
  percent            Int
  status             CommissionStatus @default(APPROVED)
  createdAt          DateTime         @default(now())
  paidAt             DateTime?
  payoutId           String?
  payout             Payout? @relation(fields: [payoutId], references: [id])
}

model Setting {
  key                String   @id
  value              String
  updatedAt          DateTime @updatedAt
}

model PasswordReset {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}
model Payout {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  amount Int
  bankName String
  accountNumber String
  accountName String
  status PayoutStatus @default(PENDING)
  reviewNote String?
  transferReference String?
  reviewedById String?
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  paidAt DateTime?
  commissions Commission[]
  @@index([userId, status])
}
model RateLimit {
  key String @id
  hits Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}
